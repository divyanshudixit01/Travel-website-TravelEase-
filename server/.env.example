PORT=5000
MONGODB_URI=mongodb://localhost:27017/travelease
JWT_SECRET=your_production_jwt_secret_change_me
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Real-time API Providers
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
RAPIDAPI_FLIGHTS_HOST=booking-com15.p.rapidapi.com
LITEAPI_KEY=your_liteapi_key_here

# Groq LPU AI Engine (Primary AI Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Razorpay Payment Gateway (India-First)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
